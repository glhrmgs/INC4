+++ ./deps/deeploy/Deeploy/Targets/Generic/Parsers.py	2026-11-23 22:20:23.557060156 -0300
@@ -3124,3 +3124,126 @@ class GlobalMaxPoolParser(GlobalPoolPars
 
     def parseNode(self, node: gs.Node) -> bool:
         return super().parseNode(node) and node.op == 'GlobalMaxPool'
+
+
+class ResizeParser(NodeParser):
+    def parseNode(self, node: gs.Node) -> bool:
+        # This parser implements only a restricted subset of ONNX Resize.
+        # Supported configuration:
+        #   - 3 inputs: X, roi, scales
+        #   - nearest interpolation
+        #   - asymmetric coordinate transformation
+        #   - floor nearest mode
+        #   - scales-based resizing (no sizes input)
+
+        if len(node.inputs) != 3 or len(node.outputs) != 1:
+            return False
+
+        # The fourth input (sizes) must not be present.
+        # With three inputs, the third input corresponds to scales.
+        if not node.inputs[2].name:
+            return False
+
+        attrs = node.attrs
+
+        # Interpolation mode
+        mode = attrs.get('mode', b'nearest')
+        if isinstance(mode, bytes):
+            mode = mode.decode('utf-8')
+
+        if mode != 'nearest':
+            return False
+
+        # Coordinate transformation
+        coordinate_mode = attrs.get('coordinate_transformation_mode', b'half_pixel')
+        if isinstance(coordinate_mode, bytes):
+            coordinate_mode = coordinate_mode.decode('utf-8')
+
+        if coordinate_mode != 'asymmetric':
+            return False
+
+        # Nearest-neighbor rounding mode
+        nearest_mode = attrs.get('nearest_mode', b'round_prefer_floor')
+        if isinstance(nearest_mode, bytes):
+            nearest_mode = nearest_mode.decode('utf-8')
+
+        if nearest_mode != 'floor':
+            return False
+
+        # This implementation does not support aspect-ratio preservation.
+        keep_aspect_ratio_policy = attrs.get(
+            'keep_aspect_ratio_policy', b'stretch'
+        )
+
+        if isinstance(keep_aspect_ratio_policy, bytes):
+            keep_aspect_ratio_policy = keep_aspect_ratio_policy.decode('utf-8')
+
+        if keep_aspect_ratio_policy.strip() != 'stretch':
+            return False
+
+        # Store supported operator attributes
+        self.operatorRepresentation['mode'] = mode
+        self.operatorRepresentation['coordinate_transformation_mode'] = coordinate_mode
+        self.operatorRepresentation['nearest_mode'] = nearest_mode
+
+        return True
+
+    def parseNodeCtxt(self,
+                      ctxt: NetworkContext,
+                      node: gs.Node,
+                      channels_first: bool = True) -> Tuple[NetworkContext, bool]:
+        data_in = ctxt.lookup(node.inputs[0].name)
+        data_out = ctxt.lookup(node.outputs[0].name)
+
+        if len(data_in.shape) != 4 or len(data_out.shape) != 4:
+            return ctxt, False
+
+        scales_buf = ctxt.lookup(node.inputs[2].name)
+
+        if not isinstance(scales_buf, ConstantBuffer):
+            return ctxt, False
+
+        scales = np.asarray(scales_buf.values, dtype=np.float32)
+
+        if scales.shape != (4,):
+            return ctxt, False
+
+        # Batch and channel dimensions must not be resized
+        if not np.isclose(scales[0], 1.0) or not np.isclose(scales[1], 1.0):
+            return ctxt, False
+
+        if channels_first:
+            batch, ch, in_h, in_w = data_in.shape
+            out_batch, out_ch, out_h, out_w = data_out.shape
+        else:
+            batch, in_h, in_w, ch = data_in.shape
+            out_batch, out_h, out_w, out_ch = data_out.shape
+
+        if batch != out_batch or ch != out_ch:
+            return ctxt, False
+
+        if not np.isclose(scales[2], out_h / in_h):
+            return ctxt, False
+
+        if not np.isclose(scales[3], out_w / in_w):
+            return ctxt, False
+
+        self.operatorRepresentation['data_in'] = data_in.name
+        self.operatorRepresentation['data_out'] = data_out.name
+
+        self.operatorRepresentation['scale_h'] = float(scales[2])
+        self.operatorRepresentation['scale_w'] = float(scales[3])
+
+        self.operatorRepresentation['batch'] = int(batch)
+        self.operatorRepresentation['ch_im_in'] = int(ch)
+
+        self.operatorRepresentation['dim_im_in_x'] = int(in_w)
+        self.operatorRepresentation['dim_im_in_y'] = int(in_h)
+
+        self.operatorRepresentation['dim_im_out_x'] = int(out_w)
+        self.operatorRepresentation['dim_im_out_y'] = int(out_h)
+
+        self.operatorRepresentation['channels_first'] = channels_first
+
+        return ctxt, True
+


