+class ResizeChecker(SignPropTypeChecker):
+
+    def __init__(
+        self,
+        input_types: Sequence[Type[Pointer]],
+        output_types: Sequence[Type[Pointer]]
+    ):
+        # Espera 4 tipos: data_in, roi, scales, data_out
+        assert len(input_types) == 4, \
+            f"ResizeChecker expects 4 input types (data_in, roi, scales, data_out), got {len(input_types)}"
+        super().__init__(input_types, output_types)
+
+    def typeCheckNodeInputs(self, ctxt: NetworkContext, node: gs.Node) -> bool:
+        """Sobrescreve o typeCheckNodeInputs do NodeTypeChecker para pular
+        ConstantBuffers vazios (o `roi` do Resize tem shape (0,) e o
+        checkPromotion do float32_t estoura em value.max() de array vazio).
+        """
+        retCheck = True
+
+        for inputNode, _type in zip(node.inputs, self.input_types):
+            reference = ctxt.lookup(inputNode.name)
+
+            if not isinstance(reference, VariableBuffer):
+                return False
+
+            if hasattr(reference, "values"):
+                # ConstantBuffer: pula arrays vazios (roi do Resize)
+                if reference.values.size == 0:
+                    continue
+                retCheck &= _type.referencedType.checkPromotion(reference.values)
+            else:
+                # VariableBuffer: comportamento original
+                if ctxt.is_global(inputNode.name):
+                    retCheck &= _type.referencedType.partialOrderUpcast(reference._type.referencedType)
+                    if retCheck:
+                        reference._type = _type
+                        reference._instance = _type(inputNode.name, ctxt)
+                else:
+                    retCheck &= reference._type.referencedType == _type.referencedType
+
+        return retCheck
+
+    def typeInferGlobalCtxt(self, ctxt: NetworkContext, node: gs.Node) -> NetworkContext:
+        """Sobrescreve o typeInferGlobalCtxt do NodeTypeChecker para anotar
+        _type em ConstantBuffers, inclusive os vazios (roi). O original
+        chama checkPromotion, que estoura em array vazio.
+        """
+        for inputNode, _type in zip(node.inputs, self.input_types):
+            if isinstance(ctxt.lookup(inputNode.name), ConstantBuffer):
+                reference = ctxt.lookup(inputNode.name)
+                # Pula a validação de valores para arrays vazios, mas anota
+                if reference.values.size > 0:
+                    if not _type.referencedType.checkPromotion(reference.values):
+                        raise Exception(f"Can't cast {reference} to {_type}!")
+                ctxt.annotateType(inputNode.name, _type)
+
+        return ctxt
+
+    def _inferNumLevels(self, inputs, operatorRepresentation):
+        # Só o data_in importa para o resize; os outros herdam o mesmo nLevels
+        return [inputs[0].nLevels] * len(inputs)
+
+    def _inferSignedness(self, inputs, operatorRepresentation):
+        return [True] * len(inputs)
+
+    def checkOutputType(self, inputs, operatorRepresentation):
+        # Resize não muda o tipo; qualquer tipo de input é aceitável
+        # desde que o output seja do mesmo tipo que o data_in
+        return True


