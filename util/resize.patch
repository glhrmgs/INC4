+def detect_input_types(test_dir: Path) -> tuple[list[str], list[str]]:
+    """Detect the dtype of the network's inputs and return
+    (input_type_map, input_offset_map) suitable for generateNetwork.py.
+
+    Returns ([], []) for int8 networks (the M4IA default) so their codegen is
+    unchanged. For float32 networks (e.g. YuNet), returns
+    (['input_0=float32_t'], ['input_0=0']).
+    """
+    import numpy as np
+
+    inputs_npz = test_dir / "inputs.npz"
+    if not inputs_npz.is_file():
+        return [], []
+    data = np.load(inputs_npz)
+    # The ONNX graph's input order matches the .npz key order in make_op.py's
+    # output; we only care about the first (and for single-input nets, only)
+    # input. All entries must agree.
+    dtypes = {arr.dtype for arr in data.values()}
+    if dtypes == {np.float32} or (len(dtypes) == 1 and np.issubdtype(next(iter(dtypes)), np.floating)):
+        names = list(data.files)
+        return [f"{k}=float32_t" for k in names], [f"{k}=0" for k in names]
+    return [], []
+
